    "source": "app/missions/page",
    "title": "missions page",
    "entries": [
      {
        "key": "app/missions/page:53d6141920e6661d",
        "text": "A vision for the nations."
      },
      {
        "key": "app/missions/page:aa670f39d521df25",
        "text": "To disciple believers, raise leaders, and establish God's influence across every sphere of life."
      },
      {
        "key": "app/missions/page:708451645cd401ad",
        "text": "The Great Commission."
      },
      {
        "key": "app/missions/page:daa96f42ca9ba61d",
        "text": "“Go ye therefore, and teach all nations, baptizing them in the name of the Father, and of the Son, and of the Holy Ghost: Teaching them to observe all things whatsoever I have commanded you: and, lo, I am with you alway, even unto the end of the world. Amen.”"
      },
      {
        "key": "app/missions/page:2a0eb55c387d37c1",
        "text": "Matthew 28:19–20 (KJV)"
      },
      {
        "key": "app/missions/page:ced8def7d102621e",
        "text": "Upcoming outreach."
      },
      {
        "key": "app/missions/page:fb3cdfe630d14f2c",
        "text": "Our next outreach will be announced here. Check back for the date, location, and ways to take part."
      },
      {
        "key": "app/missions/page:5b05c5a5a0f6804d",
        "text": "The next mission."
      },
      {
        "key": "app/missions/page:99c40ab405926cb5",
